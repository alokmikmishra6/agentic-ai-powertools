# Beehiiv newsletter subscription
# Get your API key from: https://app.beehiiv.com/settings/integrations
VITE_BEEHIIV_API_KEY=your_beehiiv_api_key_here

# Cloudflare Worker proxy URL for subscribe form (avoids CORS)
# Deploy workers/subscribe-proxy.js to Cloudflare Workers, then paste URL here
VITE_SUBSCRIBE_PROXY_URL=https://your-worker-name.your-subdomain.workers.dev
